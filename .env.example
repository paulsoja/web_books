# Set these as environment variables in the host. The application does not load .env files itself.
GOOGLE_PLAY_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=com.books.spasinnya
# Mount a service account JSON key as a secret file; never commit it or bundle it in Android.
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/run/secrets/google-play-service-account.json
GOOGLE_PLAY_ALLOW_TEST_PURCHASES=false
APP_ENV=production
# Existing iOS verification setting is independent of Google Play.
PURCHASE_VERIFICATION_MODE=disabled
